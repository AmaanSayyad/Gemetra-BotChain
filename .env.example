# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Reown / WalletConnect Cloud project (https://dashboard.reown.com)
# Required for Family, mobile QR, and WalletConnect wallets
VITE_WALLETCONNECT_PROJECT_ID=fd26e5a815a5b19895f10ffe06d0c9e9

# Optional: deployed GemetraCore on BOT Chain mainnet
VITE_GEMETRA_CORE_ADDRESS=

# Gemini AI (optional)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# EmailJS (optional)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Public origin for QR / mobile (optional)
VITE_APP_PUBLIC_URL=
