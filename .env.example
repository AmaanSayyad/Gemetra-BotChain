# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: WalletConnect Cloud project (injected wallets work without it)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: deployed GemetraCore on BOT Chain mainnet
VITE_GEMETRA_CORE_ADDRESS=

# Gemini AI (optional)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# EmailJS (optional)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Public origin for QR / mobile (optional)
VITE_APP_PUBLIC_URL=
